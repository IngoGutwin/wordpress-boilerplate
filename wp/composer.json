{
  "version": "1.0.0",
  "name": "lone/wordpress_composer_starter",
  "description": "WordPress Composer Starter repository for quick-starting WordPress projects",
  "authors": [
    {
      "name": "IngoGutwin",
      "email": "onmabu@gmail.com"
    }
  ],
  "require": {
    "vlucas/phpdotenv": "^5.6",
    "johnpbloch/wordpress": "6.8.3"
  },
  "config": {
    "allow-plugins": {
      "johnpbloch/wordpress-core-installer": true,
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-install-dir": "public/wordpress",
    "installer-paths": {
      "public/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
      "public/wp-content/themes/{$name}/": ["type:wordpress-theme"]
    },
    "phpcodesniffer-install-dir": "vendor/bin"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "php-stubs/wordpress-stubs": "^6.8",
    "php-stubs/wordpress-globals": "^0.2.0"
  },
  "scripts": {
    "lint:php": "./vendor/bin/phpcs --standard=.phpcs.xml.dist",
    "fix:php": "./vendor/bin/phpcbf --standard=.phpcs.xml.dist && phpcs --standard=.phpcs.xml.dist"
  }
}
